<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SafeBase{% endblock %}</title>
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        header {
            background-color: #1abc9c; /* Vert clair */
            color: white;
            padding: 1rem;
            text-align: center;
            font-size: 1.8rem;
            font-weight: bold;
            letter-spacing: 1px;
        }

        header a.brand {
            color: white;
            text-decoration: none;
            font-size: 1.8rem;
            font-weight: bold;
            letter-spacing: 1px;
        }

        header a.brand:hover {
            text-decoration: underline;
        }


        .layout {
            display: flex;
            height: calc(100vh - 72px); /* en retirant la hauteur du header */
        }

        .sidebar {
            background-color: #2c3e50;
            color: white;
            width: 220px;
            padding: 2rem 1rem;
            display: flex;
            flex-direction: column;
            justify-content: center; /* centre verticalement */
            align-items: center;     /* centre horizontalement */
        }

        .nav-links {
            display: flex;
            flex-direction: column;
            gap: 2rem; /* espace entre les boutons */
            width: 100%;
        }

        .nav-links a {
            display: block;
            background-color: #34495e;
            color: white;
            text-decoration: none;
            padding: 0.8rem 1rem;
            border-radius: 6px;
            text-align: center;
            transition: background-color 0.3s ease;
            width: 100%;
        }

        .nav-links a:hover {
            background-color: #1abc9c;
        }

        main {
            flex: 1;
            padding: 2rem;
            background-color: #f4f4f4;
        }

        h1, h2 {
            margin-top: 0;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header>
        <a href="{{ path('home') }}" class="brand">SafeBase</a>
    </header>
    <div class="layout">
        <nav class="sidebar">
            <div class="nav-links">
                <a href="{{ path('connexion_bdd') }}">Connexion</a>
                <a href="#">Sauvegardes</a>
                <a href="#">Restaurations</a>
                <a href="#">Logs</a>
            </div>
        </nav>
        <main>
            {% block body %}{% endblock %}
        </main>
    </div>
    {% block javascripts %}{% endblock %}
</body>
</html>
